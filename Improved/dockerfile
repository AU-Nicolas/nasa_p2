# Builds improved.py into an image; same as Original/dockerfile apart from the script
FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY improved.py .

# Unbuffered output ensures print statements show up immediately in kubectl logs
ENV PYTHONUNBUFFERED=1

CMD ["python", "improved.py"]